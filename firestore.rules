rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.role == "user"
        && request.resource.data.isPremium == false;

      allow read: if isOwner(userId) || isAdmin();

      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["name", "nickname", "avatarUrl"])
      );

      allow delete: if isAdmin();
    }

    match /spots/{spotId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["spotId", "userId", "user", "stars", "text", "time", "createdAt"])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.spotId is string
        && request.resource.data.user is string
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stars", "text"])
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000
      );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["userId", "initials", "avatarBg", "name", "text", "tag", "tagColor", "hasImg", "imageUrl", "likes", "comments", "time", "createdAt"])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 5000
        && request.resource.data.likes == 0
        && request.resource.data.comments == 0
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() || (
        signedIn()
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes"])
            && request.resource.data.likes is int
            && request.resource.data.likes >= 0
            && (
              (
                request.resource.data.likes == resource.data.likes + 1
                && !exists(/databases/$(database)/documents/likes/$(postId + "_" + request.auth.uid))
                && existsAfter(/databases/$(database)/documents/likes/$(postId + "_" + request.auth.uid))
              )
              || (
                request.resource.data.likes == resource.data.likes - 1
                && exists(/databases/$(database)/documents/likes/$(postId + "_" + request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/likes/$(postId + "_" + request.auth.uid))
              )
            )
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["comments"])
            && request.resource.data.comments is int
            && request.resource.data.comments >= 0
            && request.resource.data.comments >= resource.data.comments - 1
            && request.resource.data.comments <= resource.data.comments + 1
          )
        )
      );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /likes/{likeId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && likeId == request.resource.data.postId + "_" + request.auth.uid
        && request.resource.data.keys().hasOnly(["postId", "userId", "createdAt"])
        && request.resource.data.postId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["postId", "userId", "user", "text", "createdAt"])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text"])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000
      );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /itineraries/{itineraryId} {
      allow create: if signedIn()
        && itineraryId == request.auth.uid + "_" + request.resource.data.date
        && request.resource.data.keys().hasOnly(["userId", "date", "tripName", "spots", "checklist", "minGap", "status", "manualDone", "totalFee", "createdAt", "updatedAt"])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.tripName is string
        && request.resource.data.spots is list
        && request.resource.data.checklist is map
        && (request.resource.data.minGap is int || request.resource.data.minGap is float)
        && (request.resource.data.totalFee is int || request.resource.data.totalFee is float)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow get: if isAdmin() || (
        signedIn()
        && itineraryId.matches("^" + request.auth.uid + "_.*$")
      );
      allow list: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.date == resource.data.date
        && itineraryId == request.auth.uid + "_" + resource.data.date
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["tripName", "spots", "checklist", "minGap", "status", "manualDone", "totalFee", "updatedAt"])
        && request.resource.data.updatedAt == request.time
      );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /commuteGuides/{guideId} {
      allow read: if isAdmin() || (resource.data.status == "published" && resource.data.verified == true);
      allow create, update, delete: if isAdmin();
    }

    match /commuteReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["guideId", "userId", "text", "status", "createdAt"])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.guideId is string
        && get(/databases/$(database)/documents/commuteGuides/$(request.resource.data.guideId)).data.status == "published"
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10
        && request.resource.data.text.size() <= 1000
        && request.resource.data.status == "open"
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
